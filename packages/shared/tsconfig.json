{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "declaration": true,      /* Genera archivos .d.ts (tipos) */
    "outDir": "./dist",       /* Compila en /dist */
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true, /* Vital para TypeORM */
    "experimentalDecorators": true /* Vital para TypeORM */
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}